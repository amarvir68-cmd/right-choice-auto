# Public values (safe to expose to browser)
NEXT_PUBLIC_SITE_URL=https://right-choice-auto-one.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
REQUIRE_TURNSTILE=false

# Distributed rate limiting via Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INQUIRY_RATE_LIMIT=5
INQUIRY_RATE_WINDOW_SECONDS=600

# Temporary migration-only escape hatch. Keep false after security migration.
ALLOW_LEGACY_PUBLIC_INSERTS=false
